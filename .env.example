# Copy to .env.local and fill in. Never commit real keys.

# Text assistant (Claude). Without it the assistant runs in offline mode
# (keyword search over the verified content, still with source + date).
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5-5
ANTHROPIC_MODEL=

# Voice agent (OpenAI Realtime). Without it the voice button falls back to text.
OPENAI_API_KEY=
REALTIME_MODEL=
REALTIME_VOICE=

# Database + auth: Supabase project in the EU (Frankfurt). Without them the app runs in local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (migrations, admin scripts). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Analytics: PostHog EU cloud. Without the key nothing is sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags (override DB/defaults). 1 = on, 0 = off. Demo mode (?demo=<persona>) turns voice on.
NEXT_PUBLIC_FLAG_VOICE_AGENT=
NEXT_PUBLIC_FLAG_PEOPLE_CHAT=
